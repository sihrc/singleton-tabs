{
  "manifest_version": 3,
  "name": "Singleton Tabs",
  "description": "Reuse one canonical tab for configurable URL prefixes, with an intentional duplicate override.",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Singleton Tabs",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
